{
  "name": "ws-root",
  "version": "1.0.0",
  "path": "/ws",
  "workspaces": ["packages/*"],
  "dependencies": {
    "pkg-a": {
      "name": "pkg-a",
      "version": "1.0.0",
      "path": "/ws/node_modules/pkg-a",
      "resolved": "file:../packages/pkg-a",
      "devDependencies": {
        "ws-dev-peer": "^1.0.0"
      },
      "peerDependencies": {
        "ws-dev-peer": "^1.0.0"
      },
      "dependencies": {
        "ws-dev-peer": {
          "name": "ws-dev-peer",
          "version": "1.0.0",
          "path": "/ws/node_modules/ws-dev-peer"
        }
      }
    },
    "flag-dev-opt": {
      "name": "flag-dev-opt",
      "version": "1.0.0",
      "path": "/ws/node_modules/flag-dev-opt",
      "devOptional": true
    },
    "flag-opt": {
      "name": "flag-opt",
      "version": "1.0.0",
      "path": "/ws/node_modules/flag-opt",
      "optional": true
    },
    "flag-dev": {
      "name": "flag-dev",
      "version": "1.0.0",
      "path": "/ws/node_modules/flag-dev",
      "dev": true
    },
    "flag-peer": {
      "name": "flag-peer",
      "version": "1.0.0",
      "path": "/ws/node_modules/flag-peer",
      "peer": true
    }
  }
}
